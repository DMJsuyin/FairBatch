{
  "name": "monad-clob-grid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node --import tsx scripts/compile.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1",
    "local": "node --import tsx scripts/local.ts",
    "deploy:testnet": "node --import tsx scripts/deploy.ts",
    "check": "npm run compile && npm test && npm run build",
    "fairbatch:deploy": "node --import tsx scripts/fairbatch-deploy.ts",
    "fairbatch:testnet": "node --import tsx scripts/fairbatch-deploy.ts --testnet",
    "fairbatch:api": "PORT=5197 PUBLIC_ORIGIN=http://127.0.0.1:5177 INTERNAL_RPC=http://127.0.0.1:8545 node --import tsx scripts/serve.ts",
    "fairbatch:benchmark": "node --import tsx scripts/fairbatch-benchmark.ts",
    "fairbatch:verify": "node --import tsx scripts/fairbatch-inspect.ts",
    "fairbatch:smoke": "node --import tsx scripts/fairbatch-smoke.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-shanghai": "npm:@openzeppelin/contracts@5.0.2",
    "lucide-react": "0.544.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.2",
    "ganache": "7.9.2",
    "solc": "0.8.30",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "8.3.4"
  }
}
